# --- Server ---
PORT=3001
# Comma separated list of the websites allowed to connect (your hosted frontend)
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SERVICE ROLE key: server only. NEVER put it in the frontend or in git.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local testing without Supabase (refused when NODE_ENV=production) ---
# DEV_MODE=1   -> in-memory data; tokens look like  dev:<id>:<name>:<student|admin>
